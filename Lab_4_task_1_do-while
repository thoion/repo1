#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int a[1000];
    int i, sum = 0;
    srand(time(NULL));
    for (i = 0; i < 1000; i++) {
        a[i] = rand() % 56 - 5;
    }
    i = 999;
    do {
        sum += a[i];
        i--;
    } while (i >= 0 && a[i]>=0);
    printf("Сумма (do-while): %d\n", sum);
    return 0;
}
