#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int a[1000];
    int i, sum = 0;
    
    srand(time(NULL));
    
    // Заполнение массива случайными числами от -5 до 50
    for (i = 0; i < 1000; i++) {
        a[i] = rand() % 56 - 5;  // от -5 до 50
    }
    
    // Сумма элементов с конца массива до первого отрицательного
    for (i = 999; i >= 0; i--) {
        if (a[i] < 0) {
            break;
        }
        sum += a[i];
    }
    
    printf("Сумма элементов с конца до первого отрицательного: %d\n", sum);
    
    return 0;
}
