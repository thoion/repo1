#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int a[1000];
    int i, sum = 0;    
    srand(time(NULL));
    for (i = 0; i < 1000; i++) {
        a[i] = rand() % 56 - 5;
    }
    for (i = 999; a[i] >= 0; i--) {
        printf("%d\n", a[i]);
        sum += a[i];
    }
    printf("Сумма элементов с конца до первого отрицательного: %d\n", sum);    
    return 0;
}
